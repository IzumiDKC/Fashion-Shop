@model List<FashionShopDemo.Models.Category>

@{
    ViewData["Title"] = "TreeView";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Import JsTree & jQuery -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/jstree/3.3.12/themes/default/style.min.css" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jstree/3.3.12/jstree.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.js"></script>

<style>
    #dropZone {
        width: 100%;
        min-height: 150px;
        border: 2px dashed #007bff;
        text-align: center;
        padding: 20px;
        margin-top: 20px;
        background-color: #f8f9fa;
    }

        #dropZone .badge {
            font-size: 16px;
            display: inline-flex;
            align-items: center;
        }

    .remove-chip {
        background: none;
        border: none;
        font-size: 18px;
        line-height: 1;
        cursor: pointer;
    }


</style>

<div class="container mt-4">
    <h1 class="text-center mb-4">TreeView Danh Mục Động</h1>

    <!-- Cây danh mục -->
    <div id="categoryTree"></div>

    <!-- Nút thêm danh mục -->
    <button id="addCategoryBtn" class="btn btn-success mt-3">➕ Thêm danh mục</button>

    <!-- Khu vực kéo thả -->
    <div id="dropZone">
        <h3>Danh mục đã chọn</h3>
    </div>

    <!-- Danh sách sản phẩm -->
    <h2 class="mt-4">Danh Sách Sản Phẩm</h2>
    <ul id="productList" class="list-group"></ul>
</div>
<script>
    $.noConflict();
    jQuery(document).ready(function ($) {
        var categoryData = @Html.Raw(Json.Serialize(Model));
        var selectedCategories = new Set();
        var droppedCategories = new Set();
        var tree;

        function buildTree(categories) {
            var treeData = categories.map(category => ({
                id: category.id.toString(),
                parent: category.parentId ? category.parentId.toString() : "#",
                text: category.name || "Không có tên",
                state: { "opened": false }
            }));

            treeData.push({
                id: "hot-products",
                parent: "#",
                text: "🔥 Sản Phẩm Hot",
                icon: "fas fa-fire"
            });

            return treeData;
        }

        $('#categoryTree').jstree({
            'core': {
                'data': buildTree(categoryData),
                "check_callback": true
            },
            "plugins": ["checkbox", "wholerow", "contextmenu"],
            "contextmenu": {
                "items": function ($node) {
                    return {
                        "rename": {
                            "label": "✏️ Đổi tên",
                            "action": function () {
                                $('#categoryTree').jstree("edit", $node);
                            }
                        },
                        "delete": {
                            "label": "🗑️ Xóa",
                            "action": function () {
                                deleteCategory($node.id);
                            }
                        }
                    };
                }
            }
        });

        tree = $("#categoryTree").jstree(true);

        // ✅ Ngăn click trực tiếp checkbox
        $('#categoryTree').on('click', '.jstree-checkbox', function (e) {
            e.preventDefault();
            return false;
        });

        $('#categoryTree').on("ready.jstree after_open.jstree", function () {
            $('#categoryTree li').attr("draggable", true);
        });

        $('#categoryTree').on("changed.jstree", function (e, data) {
            const newSelected = new Set(data.selected);

            // Thêm chip
            newSelected.forEach(id => {
                if (!droppedCategories.has(id)) {
                    const node = tree.get_node(id);
                    const chip = $(`
                        <span class="badge bg-primary m-1 p-2" data-chip-id="${id}">
                            ${node.text}
                            <button class="btn btn-sm btn-light ms-2 remove-chip" data-id="${id}">×</button>
                        </span>
                    `);
                    $("#dropZone").append(chip);
                    droppedCategories.add(id);
                }
            });

            // Xóa chip khi uncheck
            droppedCategories.forEach(id => {
                if (!newSelected.has(id)) {
                    $(`#dropZone span[data-chip-id="${id}"]`).remove();
                    droppedCategories.delete(id);
                }
            });

            selectedCategories = newSelected;
            fetchProducts();
        });

        $("#addCategoryBtn").click(function () {
            var newNode = tree.create_node("#", { "text": "🆕 Danh mục mới", "id": "new-" + Date.now() });
            tree.edit(newNode);

            $.ajax({
                url: "/api/trees/addCategory",
                method: "POST",
                data: JSON.stringify({ name: "Danh mục mới", parentId: null }),
                contentType: "application/json",
                success: function (res) {
                    tree.set_id(newNode, res.id);
                }
            });
        });

        function deleteCategory(categoryId) {
            if (!confirm("Bạn có chắc muốn xóa danh mục này?")) return;

            $.ajax({
                url: `/api/trees/deleteCategory/${categoryId}`,
                method: "DELETE",
                success: function () {
                    tree.delete_node(categoryId);
                },
                error: function () {
                    alert("Lỗi khi xóa danh mục.");
                }
            });
        }

        $(document).on('dragstart', '#categoryTree li', function (e) {
            const nodeId = $(this).attr('id');
            const node = tree.get_node(nodeId);
            e.originalEvent.dataTransfer.setData("category-id", node.id);
            e.originalEvent.dataTransfer.setData("category-name", node.text);
        });

        $('#dropZone').on('dragover', function (e) {
            e.preventDefault();
            $(this).css('background-color', '#e3f2fd');
        });

        $('#dropZone').on('dragleave', function () {
            $(this).css('background-color', '#f8f9fa');
        });

        $('#dropZone').on('drop', function (e) {
            e.preventDefault();
            $(this).css('background-color', '#f8f9fa');

            const categoryId = e.originalEvent.dataTransfer.getData("category-id");

            if (!categoryId || selectedCategories.has(categoryId)) return;

            // ✅ Chỉ được check thông qua drop
            tree.check_node(categoryId);
        });

        $('#dropZone').on('click', '.remove-chip', function () {
            const categoryId = $(this).data("id");

            // ✅ Cho phép kéo lại
            droppedCategories.delete(categoryId);

            // ✅ Uncheck
            tree.uncheck_node(categoryId);
        });

        function fetchProducts() {
            $("#productList").empty();
            if (selectedCategories.size === 0) return;

            let allProducts = [];
            let requests = [];

            selectedCategories.forEach(categoryId => {
                let request;
                if (categoryId === "hot-products") {
                    request = $.ajax({ url: "/api/trees/hot-products", method: "GET" });
                } else {
                    request = $.ajax({ url: `/api/trees/GetProductsByCategory/${categoryId}`, method: "GET" });
                }

                requests.push(request);
                request.done(function (products) {
                    allProducts = allProducts.concat(products);
                });
            });

            $.when.apply($, requests).done(function () {
                displayProducts(allProducts);
            }).fail(function () {
                $("#productList").append("<li class='list-group-item text-danger'>Lỗi khi tải sản phẩm.</li>");
            });
        }

        function displayProducts(products) {
            var productList = $("#productList");
            productList.empty();

            if (products.length === 0) {
                productList.append('<li class="list-group-item text-muted">Không có sản phẩm.</li>');
            } else {
                products.forEach(product => {
                    productList.append(`
                        <li class="list-group-item">
                            <input type="checkbox" checked disabled>
                            <img src="${product.imageUrl || 'https://via.placeholder.com/50'}" class="img-thumbnail" width="50">
                            <strong>${product.name}</strong> - ${product.price}.000 VNĐ
                        </li>
                    `);
                });
            }
        }
    });
</script>




